{
  "name": "pages",
  "version": "1.2.1",
  "description": "Independent web pages built with Webpack.",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:pages": "npm run build && node scripts/generate-pages-index.js",
