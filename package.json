    "lint:fix": "eslint . --fix",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "webpack": "^5.110.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  }
}
